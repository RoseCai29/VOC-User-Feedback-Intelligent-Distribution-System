OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
USE_DETERMINISTIC=false
DATABASE_URL=sqlite:///./data/voc.db
CHROMA_PERSIST_DIR=./data/chroma
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO
ENABLE_LIVE_CRAWL=false
CORS_ORIGINS=*
CONFIDENCE_THRESHOLD=0.7
DEDUP_THRESHOLD=0.75
MAX_RETRIES=1
# 分类通道: rules | semantic | small | cascade（默认 rules，级联实测低于规则）
CLASSIFIER_MODE=rules
CASCADE_FALLBACK=llm
# LLM 模式小模型直通（重训后直出 85.2% L1 @ 52.9% 覆盖）
ENABLE_FAST_PATH=true
SMALL_MODEL_PATH=./data/models/bert_voc_v2
SMALL_MODEL_CATEGORY_THRESHOLD=0.80
SMALL_MODEL_SUB_THRESHOLD=0.75
ENABLE_PENDING_POOL=true